# Normals
vn -1 0 0
vn 1 0 0
vn 0 0 1
vn 0 0 -1
vn 0 -1 0
vn 0 1 0

# Texture Coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Vertices (Cube from -0.5 to 0.5)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Faces (each face split into two triangles)
# Front (+Z)
f 5/1/3 6/2/3 7/3/3
f 5/1/3 7/3/3 8/4/3

# Back (-Z)
f 1/1/4 4/4/4 3/3/4
f 1/1/4 3/3/4 2/2/4

# Left (-X)
f 1/1/1 5/2/1 8/3/1
f 1/1/1 8/3/1 4/4/1

# Right (+X)
f 2/1/2 3/2/2 7/3/2
f 2/1/2 7/3/2 6/4/2

# Bottom (-Y)
f 1/1/5 2/2/5 6/3/5
f 1/1/5 6/3/5 5/4/5

# Top (+Y)
f 4/1/6 8/2/6 7/3/6
f 4/1/6 7/3/6 3/4/6